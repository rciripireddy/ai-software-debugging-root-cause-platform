        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"ingestion-service|incident-service|analysis-service\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "description": "95th percentile API response time, from histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"ingestion-service|incident-service|analysis-service\",uri!~\"/actuator.*|/metrics|/health.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}}"
        }
      ],
      "id": 9
    },
