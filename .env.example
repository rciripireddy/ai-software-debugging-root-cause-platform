# Local development configuration for docker-compose.yml.
# Copy this file to .env and adjust the values. .env is ignored by Git.

# PostgreSQL (required: choose your own local password)
POSTGRES_DB=rootcause
POSTGRES_USER=rootcause
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Kafka (single-node KRaft broker)
# Cluster ID must be a base64-encoded UUID. Generate a new one with:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_PORT=9092

# Host ports for application services
INGESTION_SERVICE_PORT=8081
INCIDENT_SERVICE_PORT=8082
ANALYSIS_SERVICE_PORT=8000
FRONTEND_PORT=3000

# Authentication (see docs/security.md). Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs and verifies access tokens (incident-service, ingestion-service, analysis-service).
AUTH_JWT_SECRET=
# Internal credential for analysis-service's calls to incident-service and ingestion-service.
INTERNAL_SERVICE_TOKEN=
# Key that monitored applications (and the sample scripts) send as X-Api-Key to submit events.
INGESTION_API_KEY=
# First administrator, created at startup only if the account does not exist yet. Choose your
# own password (at least 12 characters) and change it after the first sign-in on any shared
# deployment (PUT /api/v1/auth/password).
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Optional read-only account, created the same way.
AUTH_BOOTSTRAP_VIEWER_USERNAME=
AUTH_BOOTSTRAP_VIEWER_PASSWORD=
# Session length, and the cookie's Secure flag (set to true when the dashboard is served over HTTPS).
AUTH_TOKEN_TTL=60m
AUTH_COOKIE_SECURE=false
